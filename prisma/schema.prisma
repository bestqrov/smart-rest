generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PREPARING
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderSource {
  QR_CODE    // customer scanned table QR
  POS_MANUAL // staff entered order via Mini POS
}

enum BillStatus {
  OPENED          // table is active, no bill yet
  BILL_REQUESTED  // customer / waiter requested the bill
  CLOSED_PRINTED  // paid and receipt printed
  CLOSED_VIRTUAL  // paid digitally, no print
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum WaiterCallType {
  WATER
  CLEAN
  QUESTION
}

enum BillingStatus {
  GRACE_PERIOD
  COLLECTING_DEBT
  SUSPENDED
}

enum WalletLogType {
  DEBT_ACC_ORDER
  DEBT_ACC_SOCIAL
  PAYMENT_SETTLEMENT
  TRIAL_EXTENSION
}

enum StaffRole {
  CASHIER
  WAITER
  SUPERVISOR
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// ─── Tenant / Cafe ────────────────────────────────────────────────────────────

model Cafe {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  businessName String  @default("")
  subdomain    String  @unique
  country      String  @default("MA")
  currency     String  @default("MAD")
  totalSeats   Int     @default(0)
  logoUrl      String?
  lat          Float?
  lng          Float?
  socialLinks  Json?

  isActive            Boolean       @default(true)
  walletBalance       Float         @default(0.0)
  trialEndsAt         DateTime?
  hasExtendedTrial    Boolean       @default(false)
  billingStatus       BillingStatus @default(GRACE_PERIOD)
  hasSocialShareAddon Boolean       @default(false)

  // ── Smart subscription (set after trial analysis) ─────────────────────────
  subscriptionTier  String?   // 'ECONOMY' | 'ADVANCED'
  monthlyFee        Float?    // calculated monthly subscription amount
  coffeeRefPrice    Float?    // reference coffee price (auto-detected or manual)
  sandwichRefPrice  Float?    // reference sandwich price (auto-detected or manual)
  weeklyOrderCount  Int?      // order count captured at last trial-end analysis

  categories    Category[]
  tables        Table[]
  seats         Seat[]
  orders        Order[]
  billRequests  BillRequest[]
  users         User[]
  waiterCalls   WaiterCall[]
  walletLogs    WalletLog[]
  billingTiers  BillingTier[]
  staff         Staff[]
  cashierShifts CashierShift[]

}

// ─── Table & Seat (Hybrid QR Layout) ─────────────────────────────────────────

model Table {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  cafeId      String  @db.ObjectId
  cafe        Cafe    @relation(fields: [cafeId], references: [id])
  tableNumber Int
  qrToken     String  @unique
  isActive    Boolean @default(true)

  mergedIntoTableId String? @db.ObjectId
  mergedIntoTable   Table?  @relation("TableMerge", fields: [mergedIntoTableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mergedTables      Table[] @relation("TableMerge")

  seats          Seat[]
  orders         Order[]
  originalOrders Order[]       @relation("OriginalTable")
  billRequests   BillRequest[]
  waiterCalls    WaiterCall[]

  @@unique([cafeId, tableNumber])
  @@index([cafeId])
  @@index([mergedIntoTableId])
}

model Seat {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  seatNumber Int
  tableId    String @db.ObjectId
  table      Table  @relation(fields: [tableId], references: [id])
  cafeId     String @db.ObjectId
  cafe       Cafe   @relation(fields: [cafeId], references: [id])
  qrToken    String @unique @default(uuid())

  orders Order[]

  @@unique([tableId, seatNumber])
  @@index([tableId])
}

// ─── Menu ─────────────────────────────────────────────────────────────────────

model Category {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  cafeId String @db.ObjectId
  cafe   Cafe   @relation(fields: [cafeId], references: [id])
  nameAr String
  nameEn String
  nameFr String @default("")
  nameEs String @default("")
  nameDe String @default("")
  order  Int

  products Product[]

  @@index([cafeId])
}

model Product {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId     String   @db.ObjectId
  category       Category @relation(fields: [categoryId], references: [id])
  nameAr         String
  nameEn         String
  nameFr         String  @default("")
  nameEs         String  @default("")
  nameDe         String  @default("")
  description    String?
  price          Float
  imageUrl       String?
  isAvailable    Boolean @default(true)
  // commission as a fraction of sale price (e.g. 0.05 = 5%)
  commissionRate Float   @default(0.0)

  orderItems OrderItem[]

  @@index([categoryId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  cafeId          String        @db.ObjectId
  cafe            Cafe          @relation(fields: [cafeId], references: [id])
  tableId         String?       @db.ObjectId
  table           Table?        @relation(fields: [tableId], references: [id])
  originalTableId String?       @db.ObjectId
  originalTable   Table?        @relation("OriginalTable", fields: [originalTableId], references: [id])
  seatId          String?       @db.ObjectId
  seat            Seat?         @relation(fields: [seatId], references: [id])
  seatNumber      Int?
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  isPaid          Boolean       @default(false)
  totalPrice      Float
  customerPhone   String?
  createdAt       DateTime      @default(now())

  // ── Mini POS additions ──────────────────────────────────────────────────
  orderSource     OrderSource @default(QR_CODE)
  billStatus      BillStatus  @default(OPENED)
  totalCommission Float       @default(0)
  // staff member who entered the order manually (null for QR orders)
  createdById  String?     @db.ObjectId
  createdBy    Staff?      @relation(fields: [createdById], references: [id])

  items      OrderItem[]
  walletLogs WalletLog[]

  @@index([cafeId])
  @@index([tableId])
  @@index([seatId])
  @@index([createdById])
  @@index([orderSource])
  @@index([billStatus])
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id])
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  notes     String?
  // snapshot of price and commission at time of order (immutable history)
  unitPrice      Float @default(0)
  commissionRate Float @default(0)

  @@index([orderId])
  @@index([productId])
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model BillingTier {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  cafeId           String? @db.ObjectId
  cafe             Cafe?   @relation(fields: [cafeId], references: [id])
  country          String
  minOrderValue    Float
  maxOrderValue    Float
  feeAmount        Float
  isSocialShareFee Boolean @default(false)

  @@index([country])
  @@index([cafeId])
}

model WalletLog {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  cafeId          String        @db.ObjectId
  cafe            Cafe          @relation(fields: [cafeId], references: [id])
  orderId         String?       @db.ObjectId
  order           Order?        @relation(fields: [orderId], references: [id])
  amount          Float
  type            WalletLogType
  previousBalance Float
  newBalance      Float
  createdAt       DateTime      @default(now())

  @@index([cafeId])
  @@index([orderId])
}

// ─── Support models ───────────────────────────────────────────────────────────

model BillRequest {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  cafeId     String    @db.ObjectId
  cafe       Cafe      @relation(fields: [cafeId], references: [id])
  tableId    String    @db.ObjectId
  table      Table     @relation(fields: [tableId], references: [id])
  message    String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([cafeId])
  @@index([tableId])
}

model WaiterCall {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  cafeId         String         @db.ObjectId
  cafe           Cafe           @relation(fields: [cafeId], references: [id])
  tableId        String         @db.ObjectId
  table          Table          @relation(fields: [tableId], references: [id])
  type           WaiterCallType
  message        String?
  createdAt      DateTime       @default(now())
  acknowledgedAt DateTime?

  @@index([cafeId])
  @@index([tableId])
}

model User {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  email        String @unique
  passwordHash String
  cafeId       String @db.ObjectId
  cafe         Cafe   @relation(fields: [cafeId], references: [id])

  @@index([cafeId])
}

// ─── Mini POS — Staff & Shifts ────────────────────────────────────────────────

model Staff {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  cafeId   String    @db.ObjectId
  cafe     Cafe      @relation(fields: [cafeId], references: [id])
  name     String
  role     StaffRole @default(WAITER)
  // 4-digit PIN for fast POS login (stored hashed in application layer)
  pinCode  String
  isActive Boolean   @default(true)
  createdAt DateTime @default(now())

  orders        Order[]
  cashierShifts CashierShift[]

  @@index([cafeId])
  @@index([role])
}

// ─── Magic-link verification tokens (expires after 15 min, checked in app) ───

model VerificationToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String    @unique
  cafeData  Json
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model CashierShift {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  cafeId     String      @db.ObjectId
  cafe       Cafe        @relation(fields: [cafeId], references: [id])
  staffId    String      @db.ObjectId
  staff      Staff       @relation(fields: [staffId], references: [id])
  status     ShiftStatus @default(OPEN)
  startTime  DateTime    @default(now())
  endTime    DateTime?
  // cash in drawer at shift start
  initialCash       Float @default(0)
  // sum of all cash payments collected during the shift
  totalCollectedCash Float @default(0)
  notes      String?

  @@index([cafeId])
  @@index([staffId])
  @@index([status])
}
