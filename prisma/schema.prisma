generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PREPARING
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderSource {
  QR_CODE    // customer scanned table QR
  POS_MANUAL // staff entered order via Mini POS
}

enum BillStatus {
  OPENED          // table is active, no bill yet
  BILL_REQUESTED  // customer / waiter requested the bill
  CLOSED_PRINTED  // paid and receipt printed
  CLOSED_VIRTUAL  // paid digitally, no print
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum WaiterCallType {
  WATER
  CLEAN
  QUESTION
}

enum WaiterNotifType {
  none
  call_waiter
  pay_cash
  pay_tpe
}

// Embedded document — current active notification on an Order
type WaiterNotification {
  type     WaiterNotifType @default(none)
  isActive Boolean         @default(false)
}

// Embedded document — Smart WiFi config per cafe (premium feature)
type SmartWifi {
  enabled        Boolean @default(false)
  ssid           String  @default("")
  password       String  @default("")
  showAfterOrder Boolean @default(true)
}

// Embedded document — Mobile Money / Gulf payment gateway config
type PaymentConfig {
  // Africa Mobile Money
  orangeMoneyNumber String @default("")
  mtnMoMoNumber     String @default("")
  waveWallet        String @default("")
  // Gulf (Moyasar) — public/secret kept in env; only publishable key stored here
  moyasarPublishableKey String @default("")
  // Stripe Connect (future direct charges to cafe's connected account)
  stripeAccountId  String @default("")
  // WhatsApp zero-rating ingest
  whatsappNumber   String @default("")  // restaurant's WhatsApp number for *6 orders
}

enum BillingStatus {
  GRACE_PERIOD
  COLLECTING_DEBT
  SUSPENDED
}

// ─── Online Payment ───────────────────────────────────────────────────────────

enum OnlinePaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum OnlinePaymentMethod {
  STRIPE
  MOYASAR
  ORANGE_MONEY
  MTN_MOMO
  WAVE
  WHATSAPP_ORDER   // zero-rated WhatsApp ingest
}

enum WalletLogType {
  DEBT_ACC_ORDER
  DEBT_ACC_SOCIAL
  PAYMENT_SETTLEMENT
  TRIAL_EXTENSION
}

enum StaffRole {
  CASHIER
  WAITER
  SUPERVISOR
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum WaiterDutyStatus {
  ACTIVE
  OFF_DUTY
}

// ─── Tenant / Cafe ────────────────────────────────────────────────────────────

model Cafe {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  businessName String  @default("")
  subdomain    String  @unique
  country      String  @default("MA")
  currency     String  @default("MAD")
  totalSeats   Int     @default(0)
  logoUrl      String?
  lat          Float?
  lng          Float?
  socialLinks  Json?

  isActive            Boolean       @default(true)
  isProfileComplete   Boolean       @default(false)
  walletBalance       Float         @default(0.0)
  trialEndsAt         DateTime?
  hasExtendedTrial    Boolean       @default(false)
  billingStatus       BillingStatus @default(GRACE_PERIOD)
  hasSocialShareAddon Boolean       @default(false)
  // 'CAFE' = simple cafe (drinks + light snacks), 'RESTAURANT' = full meals + kitchen
  tier                String        @default("CAFE")
  // 'RESTAURANT' = daily restaurant/cafe mode | 'TRAITEUR' = events & catering mode
  accountMode         String        @default("RESTAURANT")
  // Smart WiFi — optional embedded config (null = feature not configured)
  smartWifi           SmartWifi?

  // ── Branding (QR menu appearance) ────────────────────────────────────────
  accentColor  String @default("#059669")  // hex color for QR menu theme
  primaryFont  String @default("Cairo")    // Google Font name
  localIp      String?                     // LAN IP for offline fallback (set in Settings → e.g. 192.168.1.100)

  // ── Payment gateway configuration (set in Settings → Payments) ────────────
  paymentConfig PaymentConfig?

  // ── Per-restaurant feature flags (toggled by superadmin or admin) ──────────
  smartWifiEnabled      Boolean @default(false)
  cashierPosEnabled     Boolean @default(true)
  orderingEnabled       Boolean @default(true)
  reservationsEnabled   Boolean @default(true)

  // ── Supplier-finder quota (resets monthly, Premium plan only) ─────────────
  supplierSearchesUsed Int       @default(0)
  lastCreditReset      DateTime?

  // ── Smart subscription (set after trial analysis) ─────────────────────────
  subscriptionTier  String?   // 'ECONOMY' | 'ADVANCED' — kept for legacy/estimation
  monthlyFee        Float?    // DEPRECATED — subscription is now free; kept for migration
  coffeeRefPrice    Float?    // reference coffee price (used for estimation only)
  sandwichRefPrice  Float?    // reference sandwich price (used for estimation only)
  weeklyOrderCount  Int?      // order count captured at last trial-end analysis

  // ── Commission-based billing (new model) ─────────────────────────────────
  // Subscription is FREE. Revenue = per-order commission (billing.ts tiers)
  // Optional $25 maintenance pack for Gulf / Europe regions
  billingCycle      Int?      // payment cycle in days: 8 | 15 | 26
  maintenancePack   Boolean   @default(false)  // $25 service & maintenance fee
  maintenanceFee    Float?    // maintenance amount (default 25 USD for Gulf/Europe)
  nextBillingDate   DateTime? // next expected payment due date

  categories      Category[]
  tables          Table[]
  seats           Seat[]
  orders          Order[]
  billRequests    BillRequest[]
  users           User[]
  waiterCalls     WaiterCall[]
  walletLogs      WalletLog[]
  billingTiers    BillingTier[]
  staff           Staff[]
  cashierShifts   CashierShift[]
  waiterShifts    WaiterShift[]
  waiterQRTokens  WaiterQRToken[]
  expenses        Expense[]
  paymentRequests PaymentRequest[]
  reservations    Reservation[]
  onlinePayments  OnlinePayment[]
  recipes         Recipe[]
  stockItems      StockItem[]
  printerLogs     PrinterLog[]
  qrScans         QrScan[]
  fraudAlerts        FraudAlert[]
  feedbacks          Feedback[]
  marketingCampaigns MarketingCampaign[]
  clientSessions     ClientSession[]
  events             Event[]
  guests             Guest[]

}

// ─── Table & Seat (Hybrid QR Layout) ─────────────────────────────────────────

model Table {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  cafeId      String  @db.ObjectId
  cafe        Cafe    @relation(fields: [cafeId], references: [id])
  tableNumber Int
  qrToken     String  @unique
  isActive    Boolean @default(true)
  zone        String?

  // Waiter currently serving this table (cleared when bill is closed)
  assignedWaiterId String? @db.ObjectId
  assignedWaiter   Staff?  @relation("TableWaiterAssignment", fields: [assignedWaiterId], references: [id])

  // ── Dynamic QR — one QR per table, seats assigned at scan time ───────────
  // How many guests can sit at this table (used for dynamic seat allocation)
  capacity    Int @default(4)
  // Physical QR holder decor style shown in admin: 1=card, 2=tent, 3=stand, 4=acrylic
  displayType Int @default(1)

  mergedIntoTableId String? @db.ObjectId
  mergedIntoTable   Table?  @relation("TableMerge", fields: [mergedIntoTableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mergedTables      Table[] @relation("TableMerge")

  seats           Seat[]
  orders          Order[]
  originalOrders  Order[]         @relation("OriginalTable")
  billRequests    BillRequest[]
  waiterCalls     WaiterCall[]
  clientSessions  ClientSession[]

  @@unique([cafeId, tableNumber])
  @@index([cafeId])
  @@index([mergedIntoTableId])
  @@index([assignedWaiterId])
}

model Seat {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  seatNumber Int
  tableId    String @db.ObjectId
  table      Table  @relation(fields: [tableId], references: [id])
  cafeId     String @db.ObjectId
  cafe       Cafe   @relation(fields: [cafeId], references: [id])
  qrToken    String @unique @default(uuid())

  orders Order[]

  @@unique([tableId, seatNumber])
  @@index([tableId])
}

// ─── Menu ─────────────────────────────────────────────────────────────────────

model Category {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  cafeId String @db.ObjectId
  cafe   Cafe   @relation(fields: [cafeId], references: [id])
  nameAr String
  nameEn String
  nameFr String @default("")
  nameEs String @default("")
  nameDe String @default("")
  order  Int

  products Product[]

  @@index([cafeId])
}

model Product {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId     String   @db.ObjectId
  category       Category @relation(fields: [categoryId], references: [id])
  nameAr         String
  nameEn         String
  nameFr         String  @default("")
  nameEs         String  @default("")
  nameDe         String  @default("")
  description    String?
  price          Float
  imageUrl       String?
  isAvailable    Boolean  @default(true)
  // commission as a fraction of sale price (e.g. 0.05 = 5%)
  commissionRate Float    @default(0.0)
  // Level-1 cost management: manual cost price entered by owner
  costPrice      Float?
  calories       Int?
  likesCount     Int      @default(0)
  // 'published' | 'draft' — drafts are invisible to customers
  status         String   @default("published")
  tags           String[] @default([])

  orderItems OrderItem[]
  recipe     Recipe?

  @@index([categoryId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  cafeId          String        @db.ObjectId
  cafe            Cafe          @relation(fields: [cafeId], references: [id])
  tableId         String?       @db.ObjectId
  table           Table?        @relation(fields: [tableId], references: [id])
  originalTableId String?       @db.ObjectId
  originalTable   Table?        @relation("OriginalTable", fields: [originalTableId], references: [id])
  seatId          String?       @db.ObjectId
  seat            Seat?         @relation(fields: [seatId], references: [id])
  seatNumber      Int?
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  isPaid          Boolean       @default(false)
  totalPrice      Float
  customerPhone   String?
  createdAt       DateTime      @default(now())

  // ── Mini POS additions ──────────────────────────────────────────────────
  orderSource     OrderSource @default(QR_CODE)
  billStatus      BillStatus  @default(OPENED)
  totalCommission Float       @default(0)
  // staff member who entered the order manually (null for QR orders)
  createdById  String? @db.ObjectId
  createdBy    Staff?  @relation("OrderCreatedBy", fields: [createdById], references: [id])

  // Dynamic QR session — set when order comes from the new single-QR-per-table flow
  sessionId        String?       @db.ObjectId
  session          ClientSession? @relation(fields: [sessionId], references: [id])

  // Waiter who claimed/served this order (set when they acknowledge the notification)
  assignedWaiterId String? @db.ObjectId
  assignedWaiter   Staff?  @relation("OrderWaiterAssignment", fields: [assignedWaiterId], references: [id])

  // Active waiter notification state (isActive=true = POS should alert)
  waiterNotification WaiterNotification?
  rating             Int?
  reviewText         String?

  items      OrderItem[]
  walletLogs WalletLog[]

  @@index([cafeId])
  @@index([tableId])
  @@index([seatId])
  @@index([createdById])
  @@index([assignedWaiterId])
  @@index([orderSource])
  @@index([billStatus])
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id])
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  notes     String?
  // snapshot of price and commission at time of order (immutable history)
  unitPrice      Float @default(0)
  commissionRate Float @default(0)

  @@index([orderId])
  @@index([productId])
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model BillingTier {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  cafeId           String? @db.ObjectId
  cafe             Cafe?   @relation(fields: [cafeId], references: [id])
  country          String
  minOrderValue    Float
  maxOrderValue    Float
  feeAmount        Float
  isSocialShareFee Boolean @default(false)

  @@index([country])
  @@index([cafeId])
}

model WalletLog {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  cafeId          String        @db.ObjectId
  cafe            Cafe          @relation(fields: [cafeId], references: [id])
  orderId         String?       @db.ObjectId
  order           Order?        @relation(fields: [orderId], references: [id])
  amount          Float
  type            WalletLogType
  previousBalance Float
  newBalance      Float
  createdAt       DateTime      @default(now())

  @@index([cafeId])
  @@index([orderId])
}

// ─── Support models ───────────────────────────────────────────────────────────

model BillRequest {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  cafeId     String    @db.ObjectId
  cafe       Cafe      @relation(fields: [cafeId], references: [id])
  tableId    String    @db.ObjectId
  table      Table     @relation(fields: [tableId], references: [id])
  message    String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([cafeId])
  @@index([tableId])
}

model WaiterCall {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  cafeId         String         @db.ObjectId
  cafe           Cafe           @relation(fields: [cafeId], references: [id])
  tableId        String         @db.ObjectId
  table          Table          @relation(fields: [tableId], references: [id])
  type           WaiterCallType
  message        String?
  createdAt      DateTime       @default(now())
  acknowledgedAt DateTime?

  @@index([cafeId])
  @@index([tableId])
}

model User {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  email        String @unique
  passwordHash String
  cafeId       String @db.ObjectId
  cafe         Cafe   @relation(fields: [cafeId], references: [id])

  @@index([cafeId])
}

// ─── Mini POS — Staff & Shifts ────────────────────────────────────────────────

model Staff {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  cafeId   String    @db.ObjectId
  cafe     Cafe      @relation(fields: [cafeId], references: [id])
  name     String
  role     StaffRole @default(WAITER)
  // 4-digit PIN for fast POS login (stored hashed in application layer)
  pinCode  String
  // Plain PIN stored for admin display only (show/hide in attendance panel)
  pinDisplay String?
  // Multi-role labels beyond the primary role (e.g. ["BARISTA","CLEANER"])
  roles    String[]  @default([])
  isActive Boolean   @default(true)
  createdAt DateTime @default(now())

  // Daily rate for payroll calculation (set by admin)
  dailyRate   Float            @default(0)

  // Waiter shift state (updated on clock-in / clock-out)
  shiftStatus WaiterDutyStatus @default(OFF_DUTY)
  clockInTime DateTime?

  orders         Order[]       @relation("OrderCreatedBy")
  assignedOrders Order[]       @relation("OrderWaiterAssignment")
  assignedTables Table[]       @relation("TableWaiterAssignment")
  cashierShifts  CashierShift[]
  waiterShifts   WaiterShift[]

  @@index([cafeId])
  @@index([role])
  @@index([shiftStatus])
}

// ─── Magic-link verification tokens (expires after 15 min, checked in app) ───

model VerificationToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String    @unique
  cafeData  Json
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model CashierShift {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  cafeId     String      @db.ObjectId
  cafe       Cafe        @relation(fields: [cafeId], references: [id])
  staffId    String      @db.ObjectId
  staff      Staff       @relation(fields: [staffId], references: [id])
  status     ShiftStatus @default(OPEN)
  startTime  DateTime    @default(now())
  endTime    DateTime?
  // cash in drawer at shift start
  initialCash       Float @default(0)
  // sum of all cash payments collected during the shift
  totalCollectedCash Float @default(0)
  notes      String?

  @@index([cafeId])
  @@index([staffId])
  @@index([status])
}

// ─── Waiter QR Login Tokens ───────────────────────────────────────────────────

model WaiterQRToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  cafeId    String    @db.ObjectId
  cafe      Cafe      @relation(fields: [cafeId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([cafeId])
  @@index([expiresAt])
}

// ─── Daily Expenses ───────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId      String   @db.ObjectId
  cafe        Cafe     @relation(fields: [cafeId], references: [id])
  amount      Float
  category    String   // supplies | utilities | wages | rent | other
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([cafeId])
  @@index([date])
}

// ─── Waiter Shifts ────────────────────────────────────────────────────────────

model WaiterShift {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  cafeId   String    @db.ObjectId
  cafe     Cafe      @relation(fields: [cafeId], references: [id])
  staffId  String    @db.ObjectId
  staff    Staff     @relation(fields: [staffId], references: [id])
  clockIn  DateTime  @default(now())
  clockOut DateTime?

  @@index([cafeId])
  @@index([staffId])
  @@index([clockIn])
}

// ─── Sales Leads CRM (populated by the Superadmin Lead Scraper) ──────────────

model Lead {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  businessName String
  city         String
  country      String
  phone        String
  email        String   @default("")
  rating       Float    @default(0)
  // New | Contacted | Interested | Registered
  status       String   @default("New")
  platform     String   // google | facebook | instagram
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([city])
  @@index([platform])
  @@index([createdAt])
}

// ─── Reservations (client → kitchen) ─────────────────────────────────────────

model Reservation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId    String   @db.ObjectId
  cafe      Cafe     @relation(fields: [cafeId], references: [id])
  name      String
  phone     String
  guests    Int
  date      DateTime
  notes     String   @default("")
  status    String   @default("PENDING")  // PENDING | ACCEPTED | CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cafeId])
  @@index([status])
  @@index([date])
}

// ─── Smart Costing — Recipes & Ingredients ───────────────────────────────────

type RecipeIngredient {
  ingredientName     String
  quantityGramsOrMl  Float
  costPerUnit        Float   // cost per gram / ml in local currency
}

model Recipe {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  cafeId           String             @db.ObjectId
  cafe             Cafe               @relation(fields: [cafeId], references: [id])
  productId        String             @db.ObjectId @unique
  product          Product            @relation(fields: [productId], references: [id])
  costingMode      String             @default("Standard")  // Standard | Smart_Costing
  ingredients      RecipeIngredient[]
  calculatedCost   Float              @default(0)
  profitMargin     Float              @default(0)           // product.price - calculatedCost
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([cafeId])
}

// ─── Inventory Stock ──────────────────────────────────────────────────────────

model StockItem {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId            String   @db.ObjectId
  cafe              Cafe     @relation(fields: [cafeId], references: [id])
  ingredientName    String
  unit              String   @default("g")   // g | ml | pcs
  currentQty        Float    @default(0)
  minimumThreshold  Float    @default(0)     // alert fires below this
  costPerUnit       Float    @default(0)
  isLow             Boolean  @default(false)
  lastRestockedAt   DateTime?
  updatedAt         DateTime @updatedAt

  @@unique([cafeId, ingredientName])
  @@index([cafeId])
  @@index([isLow])
}

// ─── Printer Logs (ingested from Silent Print Spy / POS Bridge) ───────────────

model PrinterLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId     String   @db.ObjectId
  cafe       Cafe     @relation(fields: [cafeId], references: [id])
  tableNumber Int?
  items      Json     // [{ name, price, qty }]
  totalPrice Float
  source     String   @default("pos_bridge")  // pos_bridge | manual
  receivedAt DateTime @default(now())

  @@index([cafeId])
  @@index([receivedAt])
  @@index([tableNumber])
}

// ─── QR Scan Activity (anti-fraud session tracking) ──────────────────────────

model QrScan {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId         String   @db.ObjectId
  cafe           Cafe     @relation(fields: [cafeId], references: [id])
  tableNumber    Int
  tableToken     String
  scanTime       DateTime @default(now())
  lastActiveAt   DateTime @default(now())   // bumped by heartbeat
  activeDurationMin Int   @default(0)       // minutes since first scan
  orderedItems   Json?    // snapshot of items added to cart (set on order)
  hasOrder       Boolean  @default(false)   // true once /api/orders is called

  @@index([cafeId])
  @@index([scanTime])
  @@index([tableNumber])
}

// ─── Fraud Alerts ─────────────────────────────────────────────────────────────

model FraudAlert {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId      String   @db.ObjectId
  cafe        Cafe     @relation(fields: [cafeId], references: [id])
  tableNumber Int
  detectedAt  DateTime @default(now())
  details     String
  status      String   @default("Pending")  // Pending | Reviewed | Dismissed
  resolvedAt  DateTime?

  @@index([cafeId])
  @@index([status])
  @@index([detectedAt])
}

// ─── Customer Feedback (direct-to-owner, bypasses staff) ─────────────────────

model Feedback {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId      String   @db.ObjectId
  cafe        Cafe     @relation(fields: [cafeId], references: [id])
  tableNumber Int?
  tableToken  String?
  score       Int      // 1–5
  comment     String   @default("")
  lang        String   @default("ar")
  createdAt   DateTime @default(now())

  @@index([cafeId])
  @@index([score])
  @@index([createdAt])
}

// ─── Online Payment Sessions (Gulf Stripe / Africa Mobile Money) ─────────────

model OnlinePayment {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  cafeId        String              @db.ObjectId
  cafe          Cafe                @relation(fields: [cafeId], references: [id])
  orderId       String?             @db.ObjectId   // null until order confirmed post-payment
  amount        Float
  currency      String
  method        OnlinePaymentMethod
  status        OnlinePaymentStatus @default(PENDING)

  // Stripe fields (Gulf)
  stripeSessionId     String?
  stripePaymentIntent String?

  // Moyasar fields (Gulf alternative)
  moyasarPaymentId    String?

  // Mobile Money fields (Africa)
  mobileMoneyOperator String?        // orange | mtn | wave
  mobileMoneyRef      String?        // reference code returned by operator

  // WhatsApp ingest (zero-rating)
  whatsappMessageId   String?
  rawWhatsappText     String?        // original message body

  // Table context (carried through payment flow before order creation)
  tableToken          String?
  seatToken           String?
  customerPhone       String?
  itemsSnapshot       Json?          // [{productId, quantity, notes}] at time of initiation

  expiresAt     DateTime
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([cafeId])
  @@index([status])
  @@index([stripeSessionId])
  @@index([stripePaymentIntent])
  @@index([moyasarPaymentId])
  @@index([createdAt])
}

// ─── Site Config (editable landing page content) ─────────────────────────────

model SiteConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Payment Requests (Superadmin Payment Gateway) ────────────────────────────

model PaymentRequest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId     String   @db.ObjectId
  cafe       Cafe     @relation(fields: [cafeId], references: [id])
  amount     Float
  currency   String
  method     String            // BANK_TRANSFER | WESTERN_UNION | PAYPAL
  reference  String
  proofNote  String?
  status     String   @default("PENDING")  // PENDING | CONFIRMED | REJECTED
  reviewNote String?
  createdAt  DateTime @default(now())
  reviewedAt DateTime?

  @@index([cafeId])
  @@index([status])
  @@index([createdAt])
}

// ─── Dynamic QR — Client Sessions (one QR per table, seats assigned at scan) ──
//
// Flow: customer scans Table.qrToken → POST /api/qr/scan with deviceId
//       → server assigns next free seatNumber (1..Table.capacity)
//       → returns ClientSession.id stored in browser localStorage
//       → all orders from that device carry sessionId (no seatToken needed)

model ClientSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId       String   @db.ObjectId
  cafe         Cafe     @relation(fields: [cafeId], references: [id])
  tableId      String   @db.ObjectId
  table        Table    @relation(fields: [tableId], references: [id])

  // Dynamically assigned seat number (1 .. Table.capacity)
  seatNumber   Int

  // Opaque device identifier (UUID generated once in browser, stored in localStorage)
  deviceId     String

  // active | completed | expired
  status       String   @default("active")

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  // Auto-expires 2h after last heartbeat; nightly cron marks stale ones expired
  expiresAt    DateTime

  orders       Order[]

  @@index([cafeId])
  @@index([tableId, status])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([status])
}

// ─── Marketing Campaigns (Automated Video Engine) ─────────────────────────────

model MarketingCampaign {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId       String   @db.ObjectId
  cafe         Cafe     @relation(fields: [cafeId], references: [id])

  // Dish snapshot at time of generation (immutable — product may change later)
  productId    String?  @db.ObjectId
  productName  String
  productPrice Float
  imageUrl     String?  // dish image URL passed to Creatomate

  // Localisation
  country      String   // MA | SA | AE
  caption      String?  // AI-generated marketing caption (Darija / Gulf Arabic)

  // Render output
  videoUrl        String?  // final Creatomate .mp4 URL
  hasWatermark    Boolean  @default(false)
  creatomateId    String?  // render ID for polling / audit

  // Publishing
  // pending | rendering | published | failed
  status          String   @default("pending")
  platforms       String[] @default([])  // ["tiktok","snapchat"] | ["instagram","facebook"]
  uploadPostJobId String?  // job reference from Upload-Post.com
  socialLinks     Json?    // analytics URLs returned by Upload-Post after publish

  // n8n tracing
  n8nExecutionId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cafeId])
  @@index([status])
  @@index([createdAt])
}

// ─── SmartTraiteur — Events & Catering ───────────────────────────────────────

model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId      String   @db.ObjectId
  cafe        Cafe     @relation(fields: [cafeId], references: [id])

  name        String
  type        String   @default("WEDDING")   // WEDDING | CORPORATE | BIRTHDAY | REUNION | GALA | OTHER
  date        DateTime
  venue       String   @default("")
  guestCount  Int      @default(0)
  status      String   @default("DRAFT")     // DRAFT | CONFIRMED | ACTIVE | COMPLETED | CANCELLED
  notes       String   @default("")

  clientName  String   @default("")
  clientPhone String   @default("")
  clientEmail String   @default("")

  quotedPrice  Float?
  depositPaid  Float?
  depositDate  DateTime?

  actualAttendees  Int?
  commissionAmount Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guests      Guest[]

  @@index([cafeId])
  @@index([status])
  @@index([date])
}

model Guest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId    String   @db.ObjectId
  cafe      Cafe     @relation(fields: [cafeId], references: [id])
  eventId   String   @db.ObjectId
  event     Event    @relation(fields: [eventId], references: [id])

  name        String
  phone       String   @default("")
  email       String   @default("")

  tableNumber Int?
  seatNumber  Int?

  qrToken     String   @unique @default(uuid())

  dietaryReq  String   @default("")

  checkedIn   Boolean  @default(false)
  checkedInAt DateTime?

  sessionId   String?  @db.ObjectId

  createdAt   DateTime @default(now())

  @@index([cafeId])
  @@index([eventId])
}
