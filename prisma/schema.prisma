// ─── Zone-Based Dynamic Token (Match Mode / Hybrid Layout) ───────────────────
//
// Normal Mode  → Table has fixed QR → ClientSession assigns seat dynamically
// Match Mode   → Zone has no physical tables → ActiveSession = row-chair token
//
// Flow:
//   Customer enters zone → scans zone QR → server creates ActiveSession
//   with next available tokenNumber → userIdentifier stored in browser cookie
//   → all orders carry activeSessionId

model Zone {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  cafeId           String  @db.ObjectId
  cafe             Cafe    @relation(fields: [cafeId], references: [id])

  name             String  // e.g. 'Terrasse', 'Salon VIP', 'Trottoir'

  // QR holder decor style: 1=card, 2=tent, 3=stand, 4=acrylic
  displayType      Int     @default(1)

  // When true: ignore tables, use row-chair dynamic tokens
  matchModeActive  Boolean @default(false)

  // Max concurrent token slots (safety cap to avoid overbooking)
  maxDynamicTokens Int     @default(50)

  tables           Table[]
  activeSessions   ActiveSession[]

  @@index([cafeId])
  @@index([cafeId, matchModeActive])
}

// ─── ActiveSession (Dynamic Token — Zone-Based) ───────────────────────────────
//
// One document = one customer device in a zone.
// tokenNumber is auto-incremented per zone (application layer handles sequence).
// tableId is null in Match Mode (row chairs have no fixed table).

model ActiveSession {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  cafeId         String              @db.ObjectId
  cafe           Cafe                @relation(fields: [cafeId], references: [id])

  zoneId         String              @db.ObjectId
  zone           Zone                @relation(fields: [zoneId], references: [id])

  // Null in Match Mode (row-chair); set when zone has fixed tables
  tableId        String?             @db.ObjectId
  table          Table?              @relation(fields: [tableId], references: [id])

  // Sequential number within the zone scope (e.g. token #7 at Terrasse)
  // Application assigns: MAX(tokenNumber) + 1 WHERE zoneId = X AND status = ACTIVE
  tokenNumber    Int

  // Opaque browser fingerprint — UUID generated once, stored in cookie/localStorage
  userIdentifier String

  status         ActiveSessionStatus @default(ACTIVE)

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  orders         Order[]

  @@index([cafeId])
  @@index([zoneId])
  @@index([zoneId, status])           // token assignment query
  @@index([userIdentifier])           // device re-identification
  @@index([cafeId, status])           // dashboard live view
  @@index([tableId, status])          // per-table active tokens
}

// ─── Premium Subscription Plans ───────────────────────────────────────────────
