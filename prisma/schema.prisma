// ─── Dynamic QR — Client Sessions (one QR per table, seats assigned at scan) ──
//
// Flow: customer scans Table.qrToken → POST /api/qr/scan with deviceId
//       → server assigns next free seatNumber (1..Table.capacity)
//       → returns ClientSession.id stored in browser localStorage
//       → all orders from that device carry sessionId (no seatToken needed)

model ClientSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId       String   @db.ObjectId
  cafe         Cafe     @relation(fields: [cafeId], references: [id])
  tableId      String   @db.ObjectId
  table        Table    @relation(fields: [tableId], references: [id])

  // Dynamically assigned seat number (1 .. Table.capacity)
  seatNumber   Int

  // Opaque device identifier (UUID generated once in browser, stored in localStorage)
  deviceId     String

  // active | completed | expired
  status       String   @default("active")

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  // Auto-expires 2h after last heartbeat; nightly cron marks stale ones expired
  expiresAt    DateTime

  orders       Order[]

  @@index([cafeId])
  @@index([tableId, status])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([status])
}

