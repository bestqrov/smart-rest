generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ActiveSessionStatus {
  ACTIVE
  PENDING_PAYMENT
  PAID
}

enum OrderStatus {
  PENDING
  PREPARING
  READY       // kitchen done, waiting for waiter to serve
  DELIVERED
  COMPLETED
  CANCELLED
}

// ─── Certification ────────────────────────────────────────────────────────────

enum CertificationStatus {
  PENDING    // newly registered, not yet evaluated
  ELIGIBLE   // passed all metrics, awaiting owner claim
  CERTIFIED  // officially certified (kit delivered)
  REVOKED    // previously certified but metrics dropped
}

// Embedded — live metrics snapshot updated by the monthly cron
type CertificationMetrics {
  qrUsageRate      Float @default(0)  // % of orders placed via QR (0-100)
  avgPreparationTime Float @default(0) // avg minutes from PENDING → READY
  averageRating    Float @default(0)  // avg order rating (1-5)
  reviewCount      Int   @default(0)  // total reviews submitted
  evaluatedAt      DateTime?
}

// ─── Product Modifiers ────────────────────────────────────────────────────────

// A single selectable option within a modifier group (e.g. "Large +10 MAD")
type ModifierOption {
  id             String  // client-generated UUID
  label          String  // display name: "Large", "Extra Cheese"
  priceAdjustment Float  @default(0)  // positive = surcharge, negative = discount
}

// A named group of options attached to a product (e.g. "Size", "Extras")
type ModifierGroup {
  id          String
  name        String          // "Taille", "Extras", "Cuisson"
  required    Boolean @default(false)
  multiSelect Boolean @default(false) // false = radio, true = checkbox
  options     ModifierOption[]
}

// Snapshot of a customer's choice, stored on OrderItem (immutable history)
type ChosenModifier {
  groupId    String
  groupName  String
  optionId   String
  optionLabel String
  priceAdjustment Float
}

enum OrderSource {
  QR_CODE    // customer scanned table QR
  POS_MANUAL // staff entered order via Mini POS
}

enum BillStatus {
  OPENED          // table is active, no bill yet
  BILL_REQUESTED  // customer / waiter requested the bill
  CLOSED_PRINTED  // paid and receipt printed
  CLOSED_VIRTUAL  // paid digitally, no print
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum WaiterCallType {
  WATER
  CLEAN
  QUESTION
}

enum WaiterNotifType {
  none
  call_waiter
  pay_cash
  pay_tpe
}

// Embedded document — current active notification on an Order
type WaiterNotification {
  type     WaiterNotifType @default(none)
  isActive Boolean         @default(false)
}

// Embedded document — Smart WiFi config per cafe (premium feature)
type SmartWifi {
  enabled        Boolean @default(false)
  ssid           String  @default("")
  password       String  @default("")
  showAfterOrder Boolean @default(true)
}

// Embedded document — Mobile Money / Gulf payment gateway config
type PaymentConfig {
  // Africa Mobile Money
  orangeMoneyNumber String @default("")
  mtnMoMoNumber     String @default("")
  waveWallet        String @default("")
  // Gulf (Moyasar)
  moyasarPublishableKey String @default("")
  // Stripe (cards + Apple Pay + Google Pay)
  stripePublishableKey  String @default("")
  stripeAccountId       String @default("")
  // WhatsApp zero-rating ingest
  whatsappNumber   String @default("")  // restaurant's WhatsApp number for *6 orders
}

enum BillingStatus {
  GRACE_PERIOD      // Trial window — commission-free
  COLLECTING_DEBT   // Active billing — commissions accumulate
  PAST_DUE          // Balance negative; 7-day grace period before suspension
  SUSPENDED         // Grace period elapsed without payment; service halted
}

// ─── Online Payment ───────────────────────────────────────────────────────────

enum OnlinePaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum OnlinePaymentMethod {
  STRIPE
  MOYASAR
  ORANGE_MONEY
  MTN_MOMO
  WAVE
  WHATSAPP_ORDER   // zero-rated WhatsApp ingest
}

enum WalletLogType {
  DEBT_ACC_ORDER
  DEBT_ACC_SOCIAL
  PAYMENT_SETTLEMENT
  TRIAL_EXTENSION
}

enum StaffRole {
  CASHIER
  WAITER
  SUPERVISOR
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum WaiterDutyStatus {
  ACTIVE
  OFF_DUTY
}

// ─── Tenant / Cafe ────────────────────────────────────────────────────────────

model Cafe {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  businessName String  @default("")
  subdomain    String  @unique
  country      String  @default("MA")
  currency     String  @default("MAD")
  totalSeats   Int     @default(0)
  logoUrl      String?
  lat          Float?
  lng          Float?
  socialLinks  Json?

  // ── Geo-targeting (used by n8n regional campaigns) ───────────────────────
  city         String  @default("")

  isActive            Boolean       @default(true)
  isProfileComplete   Boolean       @default(false)
  walletBalance       Float         @default(0.0)
  trialEndsAt         DateTime?
  hasExtendedTrial    Boolean       @default(false)
  billingStatus       BillingStatus @default(GRACE_PERIOD)
  gracePeriodEndsAt   DateTime?     // Set when status transitions to PAST_DUE; null otherwise
  suspendedAt         DateTime?     // Set when status transitions to SUSPENDED; null otherwise
  isPremium           Boolean       @default(false)
  hasSocialShareAddon Boolean       @default(false)
  // 'CAFE' = simple cafe (drinks + light snacks), 'RESTAURANT' = full meals + kitchen
  tier                String        @default("CAFE")
  // 'RESTAURANT' = daily restaurant/cafe mode | 'TRAITEUR' = events & catering mode
  accountMode         String        @default("RESTAURANT")
  // Persists the type chosen at signup (RESTAURANT|CAFE|TRAITEUR|PASTRY|FOOD_TRUCK|HOTEL)
  // — previously captured at signup but discarded, forcing onboarding to
  // re-ask and default back to CAFE every time. See src/onboarding/ProductCatalog.ts.
  businessType        String        @default("RESTAURANT")
  // Only meaningful when businessType === 'HOTEL': does this hotel want an
  // in-room ordering menu, an on-site restaurant/cafe menu, or both — drives
  // which starter categories getProductCatalog() offers. Null for every
  // other businessType.
  hotelServiceMode    String?
  // Smart WiFi — optional embedded config (null = feature not configured)
  smartWifi           SmartWifi?

  // ── Subscription package (used for feature gating & n8n segmentation) ────
  // 'Free' | '6-Month' | 'Annual'
  packageType         String    @default("Free")
  // $5 one-time upsell for artistic/custom QR code design
  isArtisticQrPaid    Boolean   @default(false)
  // Protected demo/seed account — never bulk-deleted
  isDemo              Boolean   @default(false)

  // ── Gamification counters (drive certification unlock) ────────────────────
  // Incremented by n8n webhook on every confirmed event/reservation
  totalEventsHosted      Int     @default(0)
  totalReservationsCount Int     @default(0)
  // Unlocked when thresholds are crossed (evaluated by certificationEval cron)
  isCertified            Boolean @default(false)

  // ── Branding (QR menu appearance + logo analysis) ─────────────────────────
  accentColor      String @default("#059669")  // hex color for QR menu theme
  // Primary brand color extracted from logo via n8n image analysis pipeline
  logoAccentColor  String @default("")
  primaryFont      String @default("Cairo")    // Google Font name
  localIp          String?                     // LAN IP for offline fallback (set in Settings → e.g. 192.168.1.100)

  // ── Payment gateway configuration (set in Settings → Payments) ────────────
  paymentConfig PaymentConfig?

  // ── Per-restaurant feature flags (toggled by superadmin or admin) ──────────
  smartWifiEnabled         Boolean @default(false)
  cashierPosEnabled        Boolean @default(true)
  orderingEnabled          Boolean @default(true)
  reservationsEnabled      Boolean @default(true)
  // Smart Inventory & Supplier Management add-on
  isSmartInventoryEnabled          Boolean   @default(false)
  // Set to true when the restaurant owner requests activation (pending superadmin approval)
  inventoryActivationRequested     Boolean   @default(false)
  inventoryActivationRequestedAt   DateTime?

  // ── Supplier-finder quota (resets monthly, Premium plan only) ─────────────
  supplierSearchesUsed Int       @default(0)
  lastCreditReset      DateTime?

  // ── Smart subscription (set after trial analysis) ─────────────────────────
  subscriptionTier  String?   // 'ECONOMY' | 'ADVANCED' — kept for legacy/estimation
  monthlyFee        Float?    // DEPRECATED — subscription is now free; kept for migration
  coffeeRefPrice    Float?    // reference coffee price (used for estimation only)
  sandwichRefPrice  Float?    // reference sandwich price (used for estimation only)
  weeklyOrderCount  Int?      // order count captured at last trial-end analysis

  // ── Commission-based billing (new model) ─────────────────────────────────
  // Subscription is FREE. Revenue = per-order commission (billing.ts tiers)
  // Optional $25 maintenance pack for Gulf / Europe regions
  billingCycle      Int?      // payment cycle in days: 8 | 15 | 26
  maintenancePack   Boolean   @default(false)  // $25 service & maintenance fee
  maintenanceFee    Float?    // maintenance amount (default 25 USD for Gulf/Europe)
  nextBillingDate   DateTime? // next expected payment due date

  // ── Review links (shown to customer on thank-you screen) ─────────────────
  googleMapsUrl     String?  // e.g. https://g.page/r/xxx/review
  tripadvisorUrl    String?  // e.g. https://www.tripadvisor.com/Restaurant_Review-...

  // ── WhatsApp re-engagement (sent to inactive customers via n8n cron) ──────
  reEngagementMessage String?  // template — use {{name}} and {{cafe}} as placeholders
  reEngagementDays    Int?     @default(7)  // days of inactivity before sending

  // K21 — Google Business review link, shown to customers after a high (>=4) rating
  googleReviewLink String?

  // ── Social media credentials (per-cafe, filled when owner connects accounts) ─
  fbPageId          String @default("")  // Facebook Page numeric ID
  fbAccessToken     String @default("")  // long-lived FB page token (~60 days)
  igUserId          String @default("")  // Instagram Business account ID
  tiktokAccessToken String @default("")  // TikTok OAuth2 access token
  snapAccessToken   String @default("")  // Snapchat OAuth2 access token
  linkedinAccessToken String @default("") // K27 — LinkedIn OAuth2 access token
  xAccessToken        String @default("") // K27 — X (Twitter) OAuth2 access token

  // ── Google Business Profile (K29) ─────────────────────────────────────────
  googleBusinessProfileId    String?   // GBP location id
  googleBusinessAccessToken  String?   // OAuth2 access token
  gbpSyncEnabled              Boolean  @default(false)
  gbpLastSyncedAt             DateTime?

  // ── Smart Resto Certified ─────────────────────────────────────────────────
  ownerPhone             String              @default("")
  ownerEmail             String              @default("")
  certificationStatus    CertificationStatus @default(PENDING)
  certificationMetrics   CertificationMetrics?
  certifiedAt            DateTime?

  // ── Loyalty program configuration (admin-configurable, see /admin/loyalty) ──
  // Currency units required to earn 1 point (e.g. 10 means "10 MAD = 1 point").
  loyaltyPointsPerCurrency    Float @default(10)
  loyaltyTierSilverThreshold  Int   @default(500)
  loyaltyTierGoldThreshold    Int   @default(2000)

  categories      Category[]
  tables          Table[]
  seats           Seat[]
  orders          Order[]
  billRequests    BillRequest[]
  users           User[]
  waiterCalls     WaiterCall[]
  walletLogs      WalletLog[]
  billingTiers    BillingTier[]
  staff           Staff[]
  cashierShifts   CashierShift[]
  waiterShifts    WaiterShift[]
  waiterQRTokens  WaiterQRToken[]
  expenses        Expense[]
  paymentRequests PaymentRequest[]
  reservations    Reservation[]
  onlinePayments  OnlinePayment[]
  recipes         Recipe[]
  stockItems      StockItem[]
  printerLogs     PrinterLog[]
  qrScans         QrScan[]
  fraudAlerts        FraudAlert[]
  feedbacks          Feedback[]
  marketingCampaigns MarketingCampaign[]
  clientSessions     ClientSession[]
  events             Event[]
  guests             Guest[]
  loyaltyAccounts    LoyaltyAccount[]
  loyaltyRewards     LoyaltyReward[]
  // Smart Inventory module relations
  inventorySuppliers   InventorySupplier[]
  purchaseOrders       PurchaseOrder[]
  systemNotifications  SystemNotification[]
  // Viral marketing hub — user-generated content with consent tracking
  reviewsGallery       ReviewGallery[]
  // Zone-Based Dynamic Token (Match Mode)
  zones                Zone[]
  activeSessions       ActiveSession[]
  // Equipment & Maintenance Management
  equipment          Equipment[]
  supplierInvoices     SupplierInvoice[]
  purchaseRequisitions PurchaseRequisition[]
  cafeCustomers        CafeCustomer[]
  billingInvoices      BillingInvoice[]

  // Multi-Branch Operations (K18) — flat self-relation, same pattern as
  // Table.mergedIntoTableId/mergedTables. Null = standalone cafe (default,
  // covers every existing row). Every other model (Product, StockItem,
  // Staff, ...) already scopes by cafeId, so branch-level menu/inventory/
  // staff isolation is already guaranteed — this only adds the grouping.
  parentCafeId String? @db.ObjectId
  parentCafe   Cafe?   @relation("CafeBranches", fields: [parentCafeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches     Cafe[]  @relation("CafeBranches")

  // Indexes for geo-targeting, package segmentation, and n8n campaign queries
  @@index([country])
  @@index([city])
  @@index([packageType])
  @@index([certificationStatus])
  @@index([billingStatus])
  @@index([parentCafeId])

}

// ─── Table & Seat (Hybrid QR Layout) ─────────────────────────────────────────

model Table {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  cafeId      String  @db.ObjectId
  cafe        Cafe    @relation(fields: [cafeId], references: [id])
  tableNumber Int
  qrToken     String  @unique
  isActive    Boolean @default(true)
  zone        String?
  // K14 — explicit override for states not derivable from active orders
  // (RESERVED | CLEANING). Null = status is computed from orders (AVAILABLE/OCCUPIED),
  // same logic already used by routes/pos/tablesStatus.ts.
  manualStatus String?

  // Waiter currently serving this table (cleared when bill is closed)
  assignedWaiterId String? @db.ObjectId
  assignedWaiter   Staff?  @relation("TableWaiterAssignment", fields: [assignedWaiterId], references: [id])

  // ── Dynamic QR — one QR per table, seats assigned at scan time ───────────
  // How many guests can sit at this table (used for dynamic seat allocation)
  capacity    Int @default(4)
  // Physical QR holder decor style shown in admin: 1=card, 2=tent, 3=stand, 4=acrylic
  displayType Int @default(1)

  // Zone assignment (null = unzoned table)
  zoneId          String? @db.ObjectId
  zoneRef         Zone?   @relation(fields: [zoneId], references: [id])

  mergedIntoTableId String? @db.ObjectId
  mergedIntoTable   Table?  @relation("TableMerge", fields: [mergedIntoTableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mergedTables      Table[] @relation("TableMerge")

  seats           Seat[]
  orders          Order[]
  originalOrders  Order[]         @relation("OriginalTable")
  billRequests    BillRequest[]
  waiterCalls     WaiterCall[]
  clientSessions  ClientSession[]
  activeSessions  ActiveSession[]

  @@unique([cafeId, tableNumber])
  @@index([cafeId])
  @@index([zoneId])
  @@index([mergedIntoTableId])
  @@index([assignedWaiterId])
}

model Seat {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  seatNumber Int
  tableId    String @db.ObjectId
  table      Table  @relation(fields: [tableId], references: [id])
  cafeId     String @db.ObjectId
  cafe       Cafe   @relation(fields: [cafeId], references: [id])
  qrToken    String @unique @default(uuid())

  orders Order[]

  @@unique([tableId, seatNumber])
  @@index([tableId])
}

// ─── Menu ─────────────────────────────────────────────────────────────────────

model Category {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  cafeId String @db.ObjectId
  cafe   Cafe   @relation(fields: [cafeId], references: [id])
  nameAr String
  nameEn String
  nameFr String @default("")
  nameEs String @default("")
  nameDe String @default("")
  order  Int

  products Product[]

  @@index([cafeId])
}

model Product {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId     String   @db.ObjectId
  category       Category @relation(fields: [categoryId], references: [id])
  nameAr         String
  nameEn         String
  nameFr         String  @default("")
  nameEs         String  @default("")
  nameDe         String  @default("")
  description    String?
  price          Float
  imageUrl       String?
  isAvailable    Boolean  @default(true)
  // commission as a fraction of sale price (e.g. 0.05 = 5%)
  commissionRate Float    @default(0.0)
  // Level-1 cost management: manual cost price entered by owner
  costPrice      Float?
  calories       Int?
  likesCount     Int      @default(0)
  // 'published' | 'draft' — drafts are invisible to customers
  status         String   @default("published")
  tags           String[] @default([])

  // ── Modifier groups (e.g. Size, Extras, Cooking style) ───────────────────
  modifierGroups ModifierGroup[]

  orderItems OrderItem[]
  recipe     Recipe?

  @@index([categoryId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  cafeId          String        @db.ObjectId
  cafe            Cafe          @relation(fields: [cafeId], references: [id])
  tableId         String?       @db.ObjectId
  table           Table?        @relation(fields: [tableId], references: [id])
  originalTableId String?       @db.ObjectId
  originalTable   Table?        @relation("OriginalTable", fields: [originalTableId], references: [id])
  seatId          String?       @db.ObjectId
  seat            Seat?         @relation(fields: [seatId], references: [id])
  seatNumber      Int?
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  isPaid          Boolean       @default(false)
  totalPrice      Float
  customerPhone   String?
  createdAt       DateTime      @default(now())

  // ── Mini POS additions ──────────────────────────────────────────────────
  orderSource     OrderSource @default(QR_CODE)
  billStatus      BillStatus  @default(OPENED)
  totalCommission Float       @default(0)
  // POS Core (K11) — order-level discount, applied on top of item subtotal
  discountAmount  Float?
  // Order Management Core (K11) — DINE_IN | TAKEAWAY | DELIVERY (defaults to DINE_IN in code when absent)
  orderType       String?
  // POS Advanced (K16) — order-level notes, and hold/resume timestamp (null = not held)
  notes           String?
  heldAt          DateTime?
  // staff member who entered the order manually (null for QR orders)
  createdById  String? @db.ObjectId
  createdBy    Staff?  @relation("OrderCreatedBy", fields: [createdById], references: [id])

  // Dynamic QR session — set when order comes from the new single-QR-per-table flow
  sessionId        String?       @db.ObjectId
  session          ClientSession? @relation(fields: [sessionId], references: [id])

  // Zone-Based Dynamic Token — set when order comes from Match Mode / Hybrid zone flow
  activeSessionId  String?       @db.ObjectId
  activeSession    ActiveSession? @relation(fields: [activeSessionId], references: [id])

  // Waiter who claimed/served this order (set when they acknowledge the notification)
  assignedWaiterId String? @db.ObjectId
  assignedWaiter   Staff?  @relation("OrderWaiterAssignment", fields: [assignedWaiterId], references: [id])

  // Active waiter notification state (isActive=true = POS should alert)
  waiterNotification WaiterNotification?
  rating             Int?
  reviewText         String?
  // set when status transitions to READY — used for avgPreparationTime metric
  preparedAt         DateTime?

  items      OrderItem[]
  walletLogs WalletLog[]

  @@index([cafeId])
  @@index([tableId])
  @@index([seatId])
  @@index([createdById])
  @@index([assignedWaiterId])
  @@index([orderSource])
  @@index([billStatus])
  @@index([activeSessionId])
  // Compound indexes for the most frequent multi-field queries
  @@index([cafeId, status])     // kitchen view: pending/preparing orders per cafe
  @@index([cafeId, createdAt])  // stats: date-range revenue queries per cafe
  @@index([cafeId, isPaid])     // billing/POS: unpaid orders per cafe
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id])
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  notes     String?
  // snapshot of price and commission at time of order (immutable history)
  unitPrice            Float           @default(0)
  commissionRate       Float           @default(0)
  // sum of all chosen modifier price adjustments (immutable snapshot)
  modifiersDelta       Float           @default(0)
  // customer's chosen modifier options (immutable snapshot)
  chosenModifiers      ChosenModifier[]

  @@index([orderId])
  @@index([productId])
}

// ─── Kitchen Display System (K12 Foundation) ─────────────────────────────────
// One ticket per order, tracked independently of Order.status (which stays
// untouched) — kitchen-side workflow: PENDING → ACCEPTED → PREPARING → READY
// → SERVED, with CANCELLED reachable up to PREPARING.
model KitchenTicket {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String    @unique @db.ObjectId
  cafeId      String    @db.ObjectId
  status      String    @default("PENDING")
  station     String?
  acceptedAt  DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([cafeId, status])
  @@map("kitchen_tickets")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model BillingTier {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  cafeId           String? @db.ObjectId
  cafe             Cafe?   @relation(fields: [cafeId], references: [id])
  country          String
  minOrderValue    Float
  maxOrderValue    Float
  feeAmount        Float
  isSocialShareFee Boolean @default(false)

  @@index([country])
  @@index([cafeId])
}

model WalletLog {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  cafeId          String        @db.ObjectId
  cafe            Cafe          @relation(fields: [cafeId], references: [id])
  orderId         String?       @db.ObjectId
  order           Order?        @relation(fields: [orderId], references: [id])
  amount          Float
  type            WalletLogType
  previousBalance Float
  newBalance      Float
  createdAt       DateTime      @default(now())

  @@index([cafeId])
  @@index([orderId])
}

// ─── Support models ───────────────────────────────────────────────────────────

model BillRequest {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  cafeId     String    @db.ObjectId
  cafe       Cafe      @relation(fields: [cafeId], references: [id])
  tableId    String    @db.ObjectId
  table      Table     @relation(fields: [tableId], references: [id])
  message    String?
  // Split bill: which seat numbers to close. Empty array = whole table.
  seatNumbers Int[]    @default([])
  // "TABLE" = everyone pays together | "SEATS" = specific seats only
  payScope   String    @default("TABLE")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([cafeId])
  @@index([tableId])
}

model WaiterCall {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  cafeId         String         @db.ObjectId
  cafe           Cafe           @relation(fields: [cafeId], references: [id])
  tableId        String         @db.ObjectId
  table          Table          @relation(fields: [tableId], references: [id])
  type           WaiterCallType
  message        String?
  createdAt      DateTime       @default(now())
  acknowledgedAt DateTime?

  @@index([cafeId])
  @@index([tableId])
}

model User {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  email        String  @unique
  passwordHash String?
  googleId     String?
  googleName   String?
  googleAvatar String?
  cafeId       String  @db.ObjectId
  cafe         Cafe    @relation(fields: [cafeId], references: [id])

  tempPasswordHash    String?
  tempPasswordExpiry  DateTime?
  forcePasswordChange Boolean   @default(false)

  passwordResetRequests PasswordResetRequest[]

  @@index([cafeId])
  @@index([googleId])
}

model PasswordResetRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  cafeName  String
  email     String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─── AI Jobs Infrastructure ───────────────────────────────────────────────────

model AIJob {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  module          String    // 'marketing' | 'certification' | 'ocr' | 'translation' | ...
  jobType         String    // 'campaign_generation' | 'menu_translation' | ...
  provider        String?   // 'gemini' | 'claude' | 'openai' | 'groq' | 'openrouter'
  model           String?   // 'gemini-1.5-flash' | 'claude-3-haiku' | ...
  status          String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  priority        Int       @default(5)        // 1 (highest) → 10 (lowest)
  progress        Int       @default(0)        // 0-100
  queuedAt        DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  retryCount      Int       @default(0)
  estimatedCost   Float?
  totalTokens     Int?
  inputReference  String?   // e.g. DemoRequest ID, CafeId
  outputReference String?   // e.g. MarketingGeneration ID
  metadata        String?   // JSON string
  errorMessage    String?

  logs            AIJobLog[]

  @@index([status])
  @@index([module])
  @@index([provider])
  @@index([queuedAt])
  @@index([jobType])
}

model AIJobLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId     String   @db.ObjectId
  job       AIJob    @relation(fields: [jobId], references: [id])
  timestamp DateTime @default(now())
  level     String   @default("INFO") // INFO | WARN | ERROR | DEBUG
  message   String
  metadata  String?  // JSON string

  @@index([jobId])
  @@index([timestamp])
}

