// ─── Tenant Lifecycle Engine ──────────────────────────────────────────────────

model TenantProfile {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String    @unique
  tenantType         String    @default("RESTAURANT")
  state              String    @default("PENDING")
  plan               String    @default("FREE")
  trialEndsAt        DateTime?
  suspendedAt        DateTime?
  suspensionType     String?
  suspensionReason   String?
  gracePeriodEndsAt  DateTime?
  activatedAt        DateTime?
  cancelledAt        DateTime?
  archivedAt         DateTime?
  defaultLanguage    String    @default("ar")
  defaultCurrency    String    @default("MAD")
  country            String    @default("MA")
  timezone           String    @default("Africa/Casablanca")
  featureOverrides   String?   // JSON: Record<string, boolean>
  tempPromotions     String?   // JSON: TempPromotion[]
  customLimits       String?   // JSON: Partial<PlanLimits>
  metadata           String?   // JSON: arbitrary extra data
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([state])
  @@index([plan])
  @@index([tenantType, state])
  @@map("tenant_profiles")
}

model TenantUsageSnapshot {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String
  period             String   // YYYY-MM
  storageBytes       Float    @default(0)
  aiRequests         Int      @default(0)
  userCount          Int      @default(0)
  tableCount         Int      @default(0)
  qrCount            Int      @default(0)
  reservations       Int      @default(0)
  marketplaceOrders  Int      @default(0)
  automations        Int      @default(0)
  certificates       Int      @default(0)
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("tenant_usage_snapshots")
}

model TenantSuspensionLog {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String
  type         String    // MANUAL | AUTOMATIC | BILLING | SECURITY | MAINTENANCE
  reason       String
  suspendedBy  String?
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@map("tenant_suspension_logs")
}

// ─── Billing Platform — Platform Invoices (subscription-based, tenant-scoped) ─

model BillingPlatformInvoice {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String    @unique
  tenantId      String
  module        String    @default("RESTAURANT")
  plan          String
  status        String    @default("DRAFT")
  subtotal      Float
  taxAmount     Float     @default(0)
  taxType       String    @default("NONE")
  taxRate       Float     @default(0)
  total         Float
  currency      String    @default("MAD")
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime
  paidAt        DateTime?
  notes         String?
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
  @@index([dueDate])
  @@map("billing_platform_invoices")
}

// K28 — Referral & Affiliate Platform. Conversion detection reuses the
// existing BillingEvents 'InvoicePaid' event (billing platform, K5/K11) via
// eventBus.subscribe — no separate payment-watching logic. referredCafeId is
// a plain denormalized id (same convention as PaymentTransaction.tenantId
// and other K18+ models), no formal relation.
model AffiliateAccount {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String   @unique
  phone            String?
  referralCode     String   @unique
  status           String   @default("ACTIVE")  // ACTIVE | SUSPENDED
  commissionType   String   @default("PERCENT")  // PERCENT | FIXED
  commissionValue  Float    @default(10)         // 10 = 10% if PERCENT, or a flat amount if FIXED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

// One row per referred tenant — doubles as the tracking record, the
// conversion record, and the commission ledger entry (payout-ready via
// commissionStatus), rather than three separate models for one lifecycle.
model ReferralConversion {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  affiliateId      String    @db.ObjectId
  referralCode     String
  referredCafeId   String    @db.ObjectId
  status           String    @default("TRACKED")  // TRACKED | CONVERTED | REJECTED
  commissionAmount Float?
  commissionStatus String    @default("PENDING")  // PENDING | APPROVED | PAID
  convertedAt      DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  @@unique([referredCafeId])
  @@index([affiliateId, commissionStatus])
  @@index([referralCode])
}

// K29 — Local SEO & Google Business Automation. Review monitoring/analytics
// reuse the existing ReviewService (K21) and FeedbackService (K23) — this
// model only tracks directory listing status ("citation hooks"), not an
// automated scanner (no such integration exists to scan against).
model SeoCitation {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  cafeId        String    @db.ObjectId
  source        String    // GOOGLE | YELP | TRIPADVISOR | FACEBOOK | OTHER
  url           String?
  status        String    @default("MISSING") // LISTED | MISSING | INCONSISTENT
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())

  @@unique([cafeId, source])
  @@index([cafeId, status])
}

// AI-assisted reply suggestions for reviews/feedback. Tracked as its own
// record (Order/Feedback aren't touched) and via the existing AIJobService
// (services/aiJobService.ts) rather than a second job-tracking mechanism.
model SeoReviewReply {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId         String   @db.ObjectId
  sourceType     String   // FEEDBACK | ORDER_REVIEW
  sourceId       String
  suggestedReply String
  aiJobId        String?
  status         String   @default("SUGGESTED") // SUGGESTED | APPROVED | SENT
  createdAt      DateTime @default(now())

  @@index([cafeId, sourceType, sourceId])
}

// ─── Billing Platform — Event Log ─────────────────────────────────────────────

model BillingEventLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String
  type      String
  module    String   @default("RESTAURANT")
  payload   String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
  @@map("billing_event_logs")
}

// K31 — Smart Intelligence Event Hub. Cross-domain persistence for every
// platform event (billing/pos/kitchen/inventory/tables/reservations/orders/
// branches/crm/loyalty/reviews/feedback/whatsapp/email/social/affiliate/seo/
// tenant/marketplace/...), not just one module — distinct purpose from
// BillingEventLog above, which stays billing-only and untouched. Backs
// event replay support.
model IntelligenceEventLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId    String
  eventName  String
  module     String
  tenantId   String?
  actor      String?
  resourceId String?
  source     String
  metadata   String?  // JSON string
  timestamp  DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([eventName])
  @@index([module])
  @@index([source])
  @@index([timestamp])
  @@map("intelligence_event_logs")
}

// K35 — Recommendation Engine Foundation. One row per (tenantId, ruleId) —
// re-running the engine updates score/priority in place rather than
// duplicating, so a rule always has at most one live recommendation per
// tenant. Status is the NEW → ACTIVE → DISMISSED → COMPLETED lifecycle.
model Recommendation {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String
  ruleId      String
  category    String
  title       String
  description String
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  score       Float
  status      String    @default("NEW")    // NEW | ACTIVE | DISMISSED | COMPLETED
  metadata    String?   // JSON string
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dismissedAt DateTime?
  completedAt DateTime?

  @@unique([tenantId, ruleId])
  @@index([tenantId, status])
  @@index([category])
  @@map("intelligence_recommendations")
}

// K36 — Insight Engine. Distinct from Recommendation above: an insight is an
// observation at a point in time (event-triggered), so every trigger
// creates a new row — no unique(tenantId, ruleId) upsert like
// Recommendation, which represents one standing actionable item per rule.
model Insight {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String
  ruleId         String
  category       String
  severity       String    @default("INFO") // INFO | WARNING | CRITICAL
  title          String
  description    String
  status         String    @default("NEW")  // NEW | ACKNOWLEDGED | RESOLVED | DISMISSED
  sourceEventId  String?                    // NormalizedIntelligenceEvent.eventId that triggered this
  metadata       String?                    // JSON string
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  @@index([tenantId, status])
  @@index([category])
  @@index([severity])
  @@map("intelligence_insights")
}

// K37 — Action Engine. Distinct from AIJobService's AIJob model (used by
// K29 for AI-specific work) — this is the generic queue for any registered
// action executor, business-agnostic. Execution is always explicit
// (enqueueAction/runAction called directly): the `mode` field records
// intent (MANUAL vs AUTOMATIC) but nothing in this codebase auto-triggers
// AUTOMATIC-mode actions yet — that wiring is out of scope by design.
model Action {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String
  executorId    String
  category      String
  mode          String    @default("MANUAL") // MANUAL | AUTOMATIC
  status        String    @default("QUEUED")  // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  input         String?   // JSON string
  resultSuccess Boolean?
  resultMessage String?
  resultData    String?   // JSON string
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([tenantId, status])
  @@index([executorId])
  @@map("intelligence_actions")
}

// K38 — Decision Engine Foundation. Synthesizes Recommendation (K35) +
// Insight (K36) records into a decision; EXECUTED only ever means "queued
// an Action (K37) via enqueueAction" — never that a business action
// actually ran, since Action Engine itself requires a separate explicit
// runAction call. Every lifecycle transition is also written to the
// existing AuditService (core) rather than a second audit table.
model Decision {
  id                        String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                  String
  ruleId                    String
  category                  String
  title                     String
  description               String
  priority                  String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  confidence                Float                          // 0-1
  status                    String    @default("PENDING")  // PENDING | APPROVED | REJECTED | EXECUTED
  suggestedActionExecutorId String?
  suggestedActionInput      String?   // JSON string
  linkedActionId            String?   // Action.id, set once executeDecision queues it
  metadata                  String?   // JSON string
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  decidedAt                 DateTime?
  executedAt                DateTime?

  @@index([tenantId, status])
  @@index([category])
  @@map("intelligence_decisions")
}

// K39 — Knowledge Engine. Versioned business facts, one table (append-only
// history + isCurrent flag for fast lookup) rather than a separate current-
// value table plus a separate history table — no duplicate storage. No
// vectors/embeddings; retrieval is by (tenantId, key), not similarity.
model KnowledgeEntry {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String
  key        String                     // namespaced, e.g. "billing.mrr", "business.peakHours"
  value      String                     // JSON-stringified string|number|boolean|null
  sourceType String                     // MANUAL | DATA_HUB | INSIGHT | DECISION | SYSTEM
  sourceId   String?
  confidence Float?
  version    Int      @default(1)
  isCurrent  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([tenantId, key, isCurrent])
  @@index([tenantId, sourceType])
  @@map("intelligence_knowledge_entries")
}

// RAG Knowledge Layer — document/chunk retrieval foundation, distinct from
// KnowledgeEntry above (which is a versioned tenant fact store keyed by
// (tenantId, key), not a document/chunk RAG system). No embedding field yet
// by design (embeddings/AI providers are explicitly out of scope for this
// sprint) — KnowledgeChunk.embedding is intentionally absent, not stubbed,
// so a future sprint adds it as a real migration rather than an unused
// column. See src/intelligence/rag/ for the service layer.
model KnowledgeRagRepository {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("intelligence_rag_repositories")
}

model KnowledgeRagDocument {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  repositoryId String
  tenantId     String                     // denormalized from the repository for direct tenant-scoped queries
  title        String
  sourceType   String                     // MANUAL | UPLOAD | URL | SYSTEM
  sourceRef    String?                    // e.g. original filename or URL
  contentType  String    @default("text/plain")
  status       String    @default("PROCESSED") // PENDING | PROCESSED | FAILED — no async pipeline yet, so PROCESSED is set synchronously by DocumentService today
  metadata     String?                    // JSON-stringified, same convention as AuditEntry.metadata
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([repositoryId])
  @@index([tenantId])
  @@index([tenantId, repositoryId])
  @@map("intelligence_rag_documents")
}

model KnowledgeRagChunk {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId   String
  repositoryId String                      // denormalized for repository-scoped search without a join
  tenantId     String                      // denormalized for tenant-scoped search without a join
  chunkIndex   Int                         // 0-based order within the document
  content      String
  tokenCount   Int?                        // approximate (word count), not a real tokenizer — see ChunkService
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([documentId])
  @@index([tenantId, repositoryId])
  @@map("intelligence_rag_chunks")
}

// K41 — Rule Engine. Distinct from the RecommendationRule/InsightRule/
// DecisionRule registries (K35/K36/K38): those hold TypeScript functions
// (code, in-memory, one global behavior). This holds DECLARATIVE rules —
// conditions + an action binding, as data — so they're persisted,
// versioned, and can be overridden per tenant without a deploy. Same
// versioning shape as KnowledgeEntry (K39): isCurrent flag + version
// counter in one table, no separate history table.
model IntelRule {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String                     // stable id across versions, e.g. "low-mrr-alert"
  tenantId     String?                    // null = platform default; set = tenant-specific override
  name         String
  category     String
  version      Int      @default(1)
  isCurrent    Boolean  @default(true)
  isActive     Boolean  @default(true)
  conditions   String                     // JSON RuleConditionGroup
  actionType   String                     // ACTION | DECISION
  actionConfig String                     // JSON RuleActionBinding
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([key, tenantId, version])
  @@index([key, tenantId, isCurrent])
  @@index([category])
  @@map("intelligence_rules")
}

// K43 — Prompt Engine. Generic, tenant-agnostic template storage (distinct
// from marketing-brain's MessageTemplate, which is domain-specific to
// campaign generation). Same versioning shape as KnowledgeEntry (K39) /
// IntelRule (K41): isCurrent flag + version counter, one table.
model IntelPromptTemplate {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String                     // stable id across versions, e.g. "seo-tip-summary"
  name         String
  category     String
  version      Int      @default(1)
  isCurrent    Boolean  @default(true)
  systemPrompt String
  userPrompt   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([key, version])
  @@index([key, isCurrent])
  @@index([category])
  @@map("intelligence_prompt_templates")
}

// ─── Billing Platform — Plans (DB-backed, managed by SuperAdmin) ───────────────

model BillingPlan {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  code                 String   @unique
  description          String?
  monthlyPrice         Float    @default(0)
  yearlyPrice          Float    @default(0)
  currency             String   @default("MAD")
  isActive             Boolean  @default(true)
  isDefault            Boolean  @default(false)
  displayOrder         Int      @default(0)
  maxUsers             Int      @default(5)
  maxStorageGB         Float    @default(10)
  aiCredits            Int      @default(0)
  marketplaceEnabled   Boolean  @default(false)
  automationEnabled    Boolean  @default(false)
  certificationEnabled Boolean  @default(false)
  apiAccess            Boolean  @default(false)
  supportLevel         String   @default("COMMUNITY")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@map("billing_plans")
}

// ─── Billing Platform — Subscriptions ────────────────────────────────────────

model BillingSubscription {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String
  planId      String
  planCode    String
  planName    String
  status      String    @default("TRIAL")
  startDate   DateTime  @default(now())
  endDate     DateTime?
  renewalDate DateTime?
  trialEndsAt DateTime?
  cancelledAt DateTime?
  graceEndsAt DateTime?
  autoRenew   Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
  @@index([renewalDate])
  @@map("billing_subscriptions")
}
