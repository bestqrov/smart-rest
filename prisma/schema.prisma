// ─── Dynamic QR — Client Sessions (one QR per table, seats assigned at scan) ──
//
// Flow: customer scans Table.qrToken → POST /api/qr/scan with deviceId
//       → server assigns next free seatNumber (1..Table.capacity)
//       → returns ClientSession.id stored in browser localStorage
//       → all orders from that device carry sessionId (no seatToken needed)

model ClientSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId       String   @db.ObjectId
  cafe         Cafe     @relation(fields: [cafeId], references: [id])
  tableId      String   @db.ObjectId
  table        Table    @relation(fields: [tableId], references: [id])

  // Dynamically assigned seat number (1 .. Table.capacity)
  seatNumber   Int

  // Opaque device identifier (UUID generated once in browser, stored in localStorage)
  deviceId     String

  // active | completed | expired
  status       String   @default("active")

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  // Auto-expires 2h after last heartbeat; nightly cron marks stale ones expired
  expiresAt    DateTime

  orders       Order[]

  @@index([cafeId])
  @@index([tableId, status])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([status])
}

// ─── Marketing Campaigns (Automated Video Engine) ─────────────────────────────

model MarketingCampaign {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId       String   @db.ObjectId
  cafe         Cafe     @relation(fields: [cafeId], references: [id])

  // Dish snapshot at time of generation (immutable — product may change later)
  productId    String?  @db.ObjectId
  productName  String
  productPrice Float
  imageUrl     String?  // dish image URL passed to Creatomate

  // Localisation
  country      String   // MA | SA | AE
  caption      String?  // AI-generated marketing caption (Darija / Gulf Arabic)

  // Render output
  videoUrl        String?  // final Creatomate .mp4 URL
  hasWatermark    Boolean  @default(false)
  creatomateId    String?  // render ID for polling / audit

  // Publishing
  // pending | rendering | published | failed
  status          String   @default("pending")
  platforms       String[] @default([])  // ["tiktok","snapchat"] | ["instagram","facebook"]
  uploadPostJobId String?  // job reference from Upload-Post.com
  socialLinks     Json?    // analytics URLs returned by Upload-Post after publish

  // n8n tracing
  n8nExecutionId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cafeId])
  @@index([status])
  @@index([createdAt])
}

// K27 — Social Media Automation Engine. Publishing reuses the existing n8n
// marketing webhook (same N8N_MARKETING_WEBHOOK_URL / Upload-Post.com
// pipeline already used by MarketingCampaign's video flow) — this is the
// generalized queue/schedule/retry layer on top of it, not a second
// per-platform integration. sourceCampaignId links back to an existing
// MarketingCampaign when the post is that campaign's video (no formal
// relation, same denormalized-id convention used elsewhere in this schema).
model SocialPost {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  cafeId           String    @db.ObjectId
  platform         String    // facebook | instagram | tiktok | snapchat | linkedin | x
  contentType      String    @default("TEXT") // VIDEO | IMAGE | TEXT
  caption          String    @default("")
  mediaUrl         String?
  sourceCampaignId String?
  status           String    @default("QUEUED") // QUEUED | SCHEDULED | PUBLISHING | PUBLISHED | FAILED
  scheduledFor     DateTime?
  retryCount       Int       @default(0)
  error            String?
  externalPostId   String?
  publishedAt      DateTime?
