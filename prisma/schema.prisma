// ─── Reservations (client → kitchen) ─────────────────────────────────────────

// Embedded snapshot of a dish/drink added at reservation time
// Consumed by n8n to generate personalised post-visit content
type ReservationItem {
  productName String
  quantity    Int
  notes       String @default("")
}

model Reservation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId      String   @db.ObjectId
  cafe        Cafe     @relation(fields: [cafeId], references: [id])
  name        String
  phone       String
  guests      Int
  tableNumber Int?     // physical table number (optional, set by staff on confirmation)
  date        DateTime
  notes       String   @default("")
  // PENDING | ACCEPTED | COMPLETED | CANCELLED | CHECKED_IN | NO_SHOW (K15)
  // COMPLETED triggers n8n review-request flow and gamification counter increment
  status      String   @default("PENDING")
  // Pre-order snapshot captured at reservation or updated by waiter during visit
  // Used by n8n to generate personalised dish highlight content
  itemsOrdered ReservationItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A completed reservation can produce one review gallery entry
  reviewGallery ReviewGallery?

  @@index([cafeId])
  @@index([status])
  @@index([date])
}

// ─── Reviews Gallery (Viral Marketing Hub) ───────────────────────────────────
//
// Lifecycle (driven by n8n):
//   1. Reservation reaches COMPLETED → n8n sends a WhatsApp/SMS review request.
//   2. Customer submits image + review via QR link → document created here.
//   3. n8n reads userConsentGranted:
//      - TRUE  → face + full content published to client's social accounts.
//      - FALSE → n8n blurs faces / crops to dishes+decor only, then publishes.
//   4. On publish: isPublishedToClientSocial = true, cafe.totalReservationsCount++.
//   5. Smart Resto blog publication gated on packageType ('6-Month' | 'Annual').
//
// Indexes support:
//   - Dashboard gallery filtered by cafe
//   - n8n queue: WHERE isPublishedToClientSocial=false AND userConsentGranted=*
//   - Rating analytics per cafe
//   - Blog queue: WHERE isPublishedToSmartRestoBlog=false AND rating >= 4

model ReviewGallery {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  cafeId        String   @db.ObjectId
  cafe          Cafe     @relation(fields: [cafeId], references: [id])
  // Optional link to the originating reservation — enables personalised content
  reservationId String?  @db.ObjectId @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  // ── Media ──────────────────────────────────────────────────────────────────
  imageUrl      String?  // Cloudinary URL of privacy-processed review photo
  qrCodeUrl     String?  // Cloudinary URL of the generated artistic QR code
  reviewText    String   @default("")
  rating        Int      @default(5)  // 1–5 stars

  // ── Privacy & Consent (GDPR-aligned) ──────────────────────────────────────
  // TRUE  → n8n may publish full image including faces
  // FALSE → n8n must run face-blur pipeline before any publication
  userConsentGranted Boolean @default(false)

  // ── Publishing state (updated by n8n after successful post) ───────────────
  // Published to the restaurant's own connected social accounts (Instagram, etc.)
  isPublishedToClientSocial    Boolean  @default(false)
  publishedToClientSocialAt    DateTime?
  // Published to the Smart Resto marketing blog (premium packages only)
  isPublishedToSmartRestoBlog  Boolean  @default(false)
  publishedToSmartRestoBlogAt  DateTime?

  // ── Moderation ─────────────────────────────────────────────────────────────
  // 'pending' | 'approved' | 'rejected'
  // n8n only picks up 'approved' items for publication
  moderationStatus  String   @default("pending")
  moderatedAt       DateTime?

  // ── n8n tracing ────────────────────────────────────────────────────────────
  n8nExecutionId    String?  // execution ID of the publish workflow run

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cafeId])
  @@index([cafeId, isPublishedToClientSocial])   // n8n publish queue
  @@index([cafeId, isPublishedToSmartRestoBlog]) // blog queue
  @@index([cafeId, rating])                      // rating analytics
  @@index([moderationStatus])
  @@index([createdAt])
}

