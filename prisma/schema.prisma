// ─── Loyalty Program ──────────────────────────────────────────────────────────
// One record per (cafeId, phone) pair.
// Points are scoped to each restaurant — no cross-restaurant sharing.

model LoyaltyAccount {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  cafeId  String @db.ObjectId
  cafe    Cafe   @relation(fields: [cafeId], references: [id])

  // Customer identifier — phone is the most reliable anonymous key we have
  phone   String

  // Accumulated points (never goes negative)
  points  Int    @default(0)

  // Running ledger — each entry is immutable
  ledger  LoyaltyEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cafeId, phone])
  @@index([cafeId])
  @@index([phone])
}

// Embedded ledger entry — appended on earn or redeem, never mutated
type LoyaltyEntry {
  type      String   // "EARN" | "REDEEM"
  points    Int      // positive = earned, negative = redeemed
  orderId   String?  // reference to the order that triggered this entry
  note      String   @default("")
  createdAt DateTime
}

