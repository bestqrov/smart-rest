{
  "name": "W2 - Review Approved → Social Post",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "review-approved",
        "responseMode": "onReceived",
        "responseData": "={\"received\": true}"
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000001",
      "name": "Webhook — Review Approved",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "review-approved"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://smartrestau.com/api/v1/review-gallery/{{ $json.body.reviewGalleryId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-secret", "value": "YOUR_INTERNAL_API_SECRET" }
          ]
        }
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Get Review Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const review = $input.item.json;\nconst stars = '⭐'.repeat(review.stars || 5);\nconst caption = `${stars}\\n\\n\"${review.reviewText}\"\\n\\n— ${review.customerName || 'Un client satisfait'}\\n\\n#restaurant #avis #${review.cafeName?.replace(/\\s+/g, '') || 'SmartRestau'}`;\nreturn [{ json: { ...review, caption } }];"
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000003",
      "name": "Build Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://smartrestau.com/api/v1/review-gallery/{{ $('Webhook — Review Approved').item.json.body.reviewGalleryId }}/published",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "x-internal-secret", "value": "YOUR_INTERNAL_API_SECRET" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"isPublishedToClientSocial\": true,\n  \"publishedToClientSocialAt\": \"{{ new Date().toISOString() }}\",\n  \"caption\": \"{{ $json.caption }}\"\n}"
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000004",
      "name": "Callback — Mark Published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://smartrestau.com/api/v1/notifications/manager",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "x-internal-secret", "value": "YOUR_INTERNAL_API_SECRET" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"cafeId\": \"{{ $('Webhook — Review Approved').item.json.body.cafeId }}\",\n  \"type\": \"NEW_REVIEW\",\n  \"title\": \"Avis publié sur les réseaux\",\n  \"body\": \"Un avis client a été publié avec succès.\",\n  \"refId\": \"{{ $('Webhook — Review Approved').item.json.body.reviewGalleryId }}\",\n  \"refType\": \"ReviewGallery\"\n}"
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000005",
      "name": "Notify Manager",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 300]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook — Review Approved": {
      "main": [[{ "node": "Get Review Data", "type": "main", "index": 0 }]]
    },
    "Get Review Data": {
      "main": [[{ "node": "Build Caption", "type": "main", "index": 0 }]]
    },
    "Build Caption": {
      "main": [[{ "node": "Callback — Mark Published", "type": "main", "index": 0 }]]
    },
    "Callback — Mark Published": {
      "main": [[{ "node": "Notify Manager", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "smart-restau" }]
}
