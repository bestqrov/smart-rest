# ─── DATABASE ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string.
# Deploy the Atlas cluster in the same region as your VPS (target RTT < 20ms).
# Required parameters already included in the template:
#   retryWrites=true             — automatic write retry on transient errors
#   w=majority                   — acknowledged by majority of replica members
#   serverSelectionTimeoutMS=5000 — fail fast (5s) instead of the default 30s
#
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DBNAME?retryWrites=true&w=majority&serverSelectionTimeoutMS=5000

# ─── APP CORE ─────────────────────────────────────────────────────────────────
# Generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET=

# Public URL of the app — no trailing slash
FRONTEND_URL=

# Used by the browser to connect to Socket.io (usually same as FRONTEND_URL)
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_BASE_URL=

# Secret for internal service-to-service calls
INTERNAL_API_SECRET=

NODE_ENV=production
LOG_LEVEL=info
PORT=3000

# ─── JWT TUNING (optional — these have defaults) ──────────────────────────────
# ACCESS_TOKEN_EXPIRY=30m
# REFRESH_TOKEN_DAYS=30

# ─── SUPERADMIN ───────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=
SUPERADMIN_SECRET=

# ─── CLOUDINARY (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── EMAIL (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must match a verified sender domain in Resend
RESEND_FROM=noreply@yourdomain.com

# ─── WHATSAPP (Evolution API) ─────────────────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=

# ─── AI ───────────────────────────────────────────────────────────────────────
# Required for Menu AI generation and Recipe AI suggestions
GROQ_API_KEY=

# ─── AUTOMATION (n8n webhooks) ────────────────────────────────────────────────
# Billing lifecycle alerts (CAFE_PAST_DUE, CAFE_SUSPENDED) — used by daily cron
N8N_BILLING_WEBHOOK=
# General WhatsApp notifications (fallback for billing webhook if above not set)
N8N_WHATSAPP_WEBHOOK=
# AI video/marketing generation workflow
N8N_MARKETING_WEBHOOK_URL=
# Review submitted by customer
N8N_WEBHOOK_URL=
# Review approved by admin — triggers social publishing workflow
N8N_WEBHOOK_REVIEW_APPROVED=
# Certification badge awarded/revoked
N8N_CERTIFICATION_WEBHOOK_URL=
# Verifies n8n calls to /api/customers/optin (x-n8n-secret header)
N8N_WEBHOOK_SECRET=
# Marketing callback verification
MARKETING_CALLBACK_SECRET=
# Client-side: review form submission webhook
NEXT_PUBLIC_N8N_REVIEW_HOOK=

# ─── PAYMENT — STRIPE (Gulf pack, optional) ───────────────────────────────────
STRIPE_SECRET_KEY=
# Required when Stripe is enabled — used for webhook signature verification
STRIPE_WEBHOOK_SECRET=

# ─── PAYMENT — MOYASAR (Gulf pack, optional) ──────────────────────────────────
# Required when Moyasar is enabled — signature verification is enforced in production
MOYASAR_SECRET_KEY=

# ─── PAYMENT — MANUAL / BANK TRANSFER / WESTERN UNION (Africa pack) ───────────
NEXT_PUBLIC_PAYPAL_LINK=
NEXT_PUBLIC_PAYMENT_BANK_NAME=
NEXT_PUBLIC_PAYMENT_BANK_ACCOUNT=
NEXT_PUBLIC_PAYMENT_BANK_IBAN=
NEXT_PUBLIC_PAYMENT_BANK_SWIFT=
NEXT_PUBLIC_PAYMENT_WU_NAME=
NEXT_PUBLIC_PAYMENT_WU_CITY=
NEXT_PUBLIC_PAYMENT_WU_COUNTRY=

# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Add GOOGLE_CALLBACK_URL to "Authorized redirect URIs" in the OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# ─── MISC / INTEGRATIONS ──────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
POSBRIDGE_SECRET=
INVENTORY_WEBHOOK_SECRET=

# OpenWeatherMap API key (free tier) — powers the admin dashboard weather widget
OPENWEATHER_API_KEY=

# WhatsApp contact number shown on the landing page
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Demo data: set to "true" to auto-seed on first boot
DEMO_SEED=false
# Subdomain of the protected demo cafe (default: plage)
# DEMO_SUBDOMAIN=plage
