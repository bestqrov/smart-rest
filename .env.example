# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── APP CORE ─────────────────────────────────────────────────────────────────
# Secret for signing JWT tokens — generate with: openssl rand -base64 32
JWT_SECRET=

# Your Railway app public URL (e.g. https://smartrestau.up.railway.app)
FRONTEND_URL=
SERVER_URL=

# Used by the browser to connect to Socket.io (same as SERVER_URL usually)
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_BASE_URL=

# Secret for internal API calls between services
INTERNAL_API_SECRET=

NODE_ENV=production
LOG_LEVEL=info
PORT=3000

# ─── SUPERADMIN ───────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=
SUPERADMIN_SECRET=

# ─── CLOUDINARY (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── EMAIL (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must match a verified sender domain in Resend
RESEND_FROM=noreply@yourdomain.com

# ─── WHATSAPP (Evolution API) ─────────────────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=

# ─── AI ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── MARKETING / AUTOMATION (n8n) ─────────────────────────────────────────────
N8N_MARKETING_WEBHOOK_URL=
N8N_WEBHOOK_RESERVATION_COMPLETED=
N8N_WEBHOOK_REVIEW_APPROVED=
MARKETING_CALLBACK_SECRET=

# ─── VIDEO GENERATION (Creatomate) ────────────────────────────────────────────
CREATOMATE_API_KEY=
CREATOMATE_TEMPLATE_ID=

# ─── POS BRIDGE ───────────────────────────────────────────────────────────────
POSBRIDGE_SECRET=

# ─── PAYMENT (optional — only if you use these) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOYASAR_SECRET_KEY=
NEXT_PUBLIC_PAYPAL_LINK=
NEXT_PUBLIC_PAYMENT_BANK_NAME=
NEXT_PUBLIC_PAYMENT_BANK_ACCOUNT=
NEXT_PUBLIC_PAYMENT_BANK_IBAN=
NEXT_PUBLIC_PAYMENT_BANK_SWIFT=
NEXT_PUBLIC_PAYMENT_WU_NAME=
NEXT_PUBLIC_PAYMENT_WU_CITY=
NEXT_PUBLIC_PAYMENT_WU_COUNTRY=

# ─── MISC ─────────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
UPLOAD_POST_API_KEY=
QR_ENGINE_URL=
INVENTORY_WEBHOOK_SECRET=

# Set to "true" to auto-seed demo data on first Boss login
DEMO_SEED=true

# WhatsApp number shown on the landing page
NEXT_PUBLIC_WHATSAPP_NUMBER=
